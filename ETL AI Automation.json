    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map((item) => {\n  try {\n    // Get JSON string from \"text\"\n    let raw = item.json.text;\n\n    // Remove unnecessary whitespace\n    raw = raw.trim();\n\n    // Remove markdown code fences if AI added them\n    raw = raw\n      .replace(/^```json\\s*/i, '')\n      .replace(/^```\\s*/i, '')\n      .replace(/\\s*```$/i, '')\n      .trim();\n\n    // Parse JSON string into an object\n    const data = JSON.parse(raw);\n\n    return {\n      json: data\n    };\n\n  } catch (error) {\n    return {\n      json: {\n        parse_error: true,\n        error: error.message,\n        original_text: item.json.text\n      }\n    };\n  }\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
